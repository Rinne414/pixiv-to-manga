{
  "name": "pixiv-to-manga",
  "version": "0.6.0",
  "description": "Privacy-first local-AI manga studio: import Pixiv or local art, generate story + dialogue with your own models, edit bubbles on a whiteboard, export ZIP/CBZ/PDF.",
  "keywords": [
    "manga",
    "comic",
    "pixiv",
    "ai",
    "local-first",
    "ollama",
    "cbz"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "pixiv-to-manga-studio": "bin/studio.mjs"
  },
  "files": [
    "bin",
    "dist",
    "dist-server",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c red,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "server": "tsx server/index.ts",
    "start": "npm run build && tsx server/index.ts --open",
    "build": "tsc -b && vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.mjs",
    "prepublishOnly": "npm run build && npm run build:server",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=23.4"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^9.3.0",
    "archiver": "^8.0.0",
    "fastify": "^5.10.0",
    "jszip": "^3.10.1",
    "open": "^11.0.0",
    "pdf-lib": "^1.17.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/archiver": "^8.0.0",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "konva": "^10.3.0",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-konva": "^19.2.5",
    "tsx": "^4.23.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rinne414/pixiv-to-manga.git"
  },
  "homepage": "https://github.com/Rinne414/pixiv-to-manga#readme",
  "bugs": {
    "url": "https://github.com/Rinne414/pixiv-to-manga/issues"
  }
}
